# Copy to .env (or export directly) — never commit real values.

# Which provider resolve/ and explain/ call. Default: groq.
BOW_LLM_PROVIDER=groq

# Set the key for whichever provider you use above.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides — defaults assume the standard repo layout and Groq's
# current model lineup (verify at https://console.groq.com/docs/models and
# https://console.groq.com/docs/vision before the graded run — Groq
# deprecates/renames models fairly often).
# BOW_DATASET_DIR=../dataset
# BOW_OUTPUT_PATH=../output.csv
# BOW_TEXT_MODEL=openai/gpt-oss-120b
# BOW_VISION_MODEL=qwen/qwen3.6-27b
